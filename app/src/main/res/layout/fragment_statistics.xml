<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="?attr/brutalistSpacingMedium">

        <!-- Title -->
        <TextView
            android:id="@+id/tv_stats_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_statistics"
            style="@style/BrutalistTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Overall Progress Section -->
        <LinearLayout
            android:id="@+id/section_overall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/brutalistSpacingMedium"
            android:orientation="vertical"
            android:padding="?attr/brutalistCardPadding"
            android:background="@drawable/bg_brutalist_card"
            app:layout_constraintTop_toBottomOf="@id/tv_stats_title">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OVERALL PERFORMANCE"
                style="@style/BrutalistHeading"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_stats_overall_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0%"
                android:textSize="56sp"
                android:textStyle="bold"
                android:textColor="@color/text_black" />

            <TextView
                android:id="@+id/tv_stats_overall_classes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 / 0 CLASSES"
                style="@style/BrutalistBody"
                android:textStyle="bold"
                android:textSize="12sp" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress_stats_overall"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Highlights Row -->
        <LinearLayout
            android:id="@+id/layout_row_best_worst"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/brutalistSpacingSmall"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/section_overall">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_badge_present">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HIGHEST"
                    style="@style/BrutalistBody"
                    android:textStyle="bold"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_best_subject_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="N/A"
                    style="@style/BrutalistHeading"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_best_subject_percentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0%"
                    style="@style/BrutalistBody"
                    android:textStyle="bold"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_badge_absent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOWEST"
                    style="@style/BrutalistBody"
                    android:textStyle="bold"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_worst_subject_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="N/A"
                    style="@style/BrutalistHeading"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_worst_subject_percentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0%"
                    style="@style/BrutalistBody"
                    android:textStyle="bold"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Detailed Summary -->
        <LinearLayout
            android:id="@+id/card_details_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/brutalistSpacingSmall"
            android:orientation="vertical"
            android:padding="?attr/brutalistCardPadding"
            android:background="@drawable/bg_brutalist_card"
            app:layout_constraintTop_toBottomOf="@id/layout_row_best_worst">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SUMMARY"
                style="@style/BrutalistHeading"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SUBJECTS"
                        style="@style/BrutalistBody"
                        android:textStyle="bold"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/tv_stats_total_subjects"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        style="@style/BrutalistHeading"
                        android:textSize="24sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TOTAL CLASSES"
                        style="@style/BrutalistBody"
                        android:textStyle="bold"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/tv_stats_total_classes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        style="@style/BrutalistHeading"
                        android:textSize="24sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/border_black"
                android:layout_marginVertical="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRESENT"
                        style="@style/BrutalistBody"
                        android:textStyle="bold"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/tv_stats_present"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        style="@style/BrutalistHeading"
                        android:textSize="24sp"
                        android:textColor="@color/brutalist_accent" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ABSENT"
                        style="@style/BrutalistBody"
                        android:textStyle="bold"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/tv_stats_absent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        style="@style/BrutalistHeading"
                        android:textSize="24sp"
                        android:textColor="@color/brutalist_absent" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="80dp"
            app:layout_constraintTop_toBottomOf="@id/card_details_summary" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
