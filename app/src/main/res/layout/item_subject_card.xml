<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    style="@style/BrutalistCard">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="?attr/brutalistCardPadding">

        <!-- Subject Name -->
        <TextView
            android:id="@+id/tv_subject_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            style="@style/BrutalistHeading"
            android:textAllCaps="true"
            app:layout_constraintEnd_toStartOf="@id/tv_percentage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="MATHEMATICS" />

        <TextView
            android:id="@+id/tv_teacher_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/BrutalistBody"
            android:textStyle="bold"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/tv_percentage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_subject_name"
            tools:text="DR. SARAH CONNOR" />

        <!-- Percentage Display -->
        <TextView
            android:id="@+id/tv_percentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_black"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="80%" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress_subject"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tv_counts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            style="@style/BrutalistBody"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_teacher_name"
            tools:text="ATTENDED: 12 / TOTAL: 15" />

        <TextView
            android:id="@+id/tv_goal_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            style="@style/BrutalistBody"
            android:textStyle="bold"
            android:textSize="11sp"
            android:textColor="@color/brutalist_accent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_counts"
            tools:text="ON TRACK! SKIP NEXT 2 CLASSES." />

        <!-- Action Buttons -->
        <LinearLayout
            android:id="@+id/layout_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tv_goal_status">

            <Button
                android:id="@+id/btn_present"
                style="@style/BrutalistButton.Present"
                android:layout_width="0dp"
                android:layout_height="?attr/brutalistButtonHeight"
                android:layout_weight="1"
                android:text="@string/btn_present" />

            <Button
                android:id="@+id/btn_absent"
                style="@style/BrutalistButton.Absent"
                android:layout_width="0dp"
                android:layout_height="?attr/brutalistButtonHeight"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/btn_absent" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackground"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/text_black"
            android:contentDescription="Menu"
            app:layout_constraintBottom_toBottomOf="@id/tv_counts"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_counts" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
